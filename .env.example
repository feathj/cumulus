# Local development runs against the native Homebrew Postgres on 5432.
#
#   createdb cumulus_dev
#   createdb cumulus_shadow
#
# The shadow database is what `prisma migrate dev` uses to detect drift. Prisma
# will create one on the fly if the role has CREATEDB, but naming it explicitly
# keeps migrate runs from churning temporary databases.
DATABASE_URL="postgresql://jono@localhost:5432/cumulus_dev?schema=public"
SHADOW_DATABASE_URL="postgresql://jono@localhost:5432/cumulus_shadow?schema=public"
